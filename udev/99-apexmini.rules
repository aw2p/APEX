
# Apex / SteelSeries keyboard hidraw access for the local user session
# (only the keyboard-family PIDs; headsets and mice are NOT matched).
# Diagnostic shortcut: instead of guessing one match each, these lines use
# a restrictive vendor+product pair per line.

# --- Apex Pro Mini Wireless family (user's device: dongle 1624) ---
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1624", MODE="0660", GROUP="input"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1626", MODE="0660", GROUP="input"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="161e", MODE="0660", GROUP="input"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1621", MODE="0660", GROUP="input"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1620", MODE="0660", GROUP="input"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1648", MODE="0660", GROUP="input"

